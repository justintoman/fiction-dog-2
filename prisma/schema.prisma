// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Story {
  slug           String    @id
  title          String
  author         User      @relation(fields: [authorId], references: [id])
  authorId       String
  image          Image     @relation(name: "StoryImage", fields: [imageId], references: [id])
  imageId        String    @unique
  firstChapterId String?
  chapters       Chapter[]
}

model Chapter {
  id          String   @id @default(cuid())
  story       Story    @relation(fields: [storySlug], references: [slug])
  storySlug   String
  content     String
  image       Image    @relation(name: "ChapterImage", fields: [imageId], references: [id])
  imageId     String   @unique
  choices     Choice[] @relation("ChoicesFromChapter")
  
  choicesFrom Choice[] @relation("ChoicesToChapter") @ignore
}

model Choice {
  id            String  @id @default(cuid())
  fromChapter   Chapter @relation(name: "ChoicesFromChapter", fields: [fromChapterId], references: [id], onDelete: Cascade)
  fromChapterId String
  toChapter     Chapter @relation(name: "ChoicesToChapter", fields: [toChapterId], references: [id], onDelete: Cascade)
  toChapterId   String

  @@unique([fromChapterId, toChapterId])
}

model Image {
  id     String @id @default(cuid())
  source Bytes
  webp   Bytes
  png    Bytes

  chapter Chapter? @relation("ChapterImage") @ignore
  story   Story?   @relation("StoryImage") @ignore
  user    User?    @relation("UserImage") @ignore
}

model User {
  id       String    @id @default(cuid())
  email    String    @unique
  name     String    @unique
  stories  Story[]
  image    Image     @relation("UserImage", fields: [imageId], references: [id])
  imageId  String    @unique
  password Password?
  sessions Session[]
}

model Password {
  hash   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Session {
  id             String   @id @default(cuid())
  expirationDate DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId         String

  // non-unique foreign key
  @@index([userId])
}
